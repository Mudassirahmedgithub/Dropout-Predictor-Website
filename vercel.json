{
  "version": 2,
  "functions": {
    "api/*.py": {
      "runtime": "@vercel/python"
    }
  },
  "routes": [
    {
      "src": "/api/predict",
      "dest": "/api/predict.py"
    },
    {
      "src": "/api/bulk-predict",
      "dest": "/api/bulk-predict.py"
    },
    {
      "src": "/api/analytics",
      "dest": "/api/analytics.py"
    },
    {
      "src": "/api/model-info",
      "dest": "/api/model-info.py"
    },
    {
      "src": "/api/upload",
      "dest": "/api/upload.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/build/$1"
    }
  ],
  "buildCommand": "cd frontend && npm install && npm run build",
  "env": {
    "PYTHONPATH": "./api"
  }
}